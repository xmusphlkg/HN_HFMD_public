"""Top-level, receipt-driven HFMD workflow (Snakemake 9.23.1)."""

from pathlib import Path
import re
import shlex

from hfmd.core.config import load_config, read_config_snapshot


ROOT = Path(workflow.basedir).resolve().parent
PROFILE = str(config.get("profile", "ci"))
if PROFILE not in {"ci", "synthetic", "restricted"}:
    raise ValueError(f"Unknown workflow profile: {PROFILE}")

RUN_ID = str(config.get("run_id", f"{PROFILE}-candidate"))
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,95}", RUN_ID):
    raise ValueError(f"Unsafe run_id: {RUN_ID!r}")

RUN_ROOT = ROOT / ".runs" / RUN_ID / "staging"
RECEIPT_ROOT = RUN_ROOT / "receipts"
CONFIG_SNAPSHOT = RUN_ROOT / "config" / "config.snapshot.json"
LOADED_CONFIG = (
    read_config_snapshot(CONFIG_SNAPSHOT)
    if CONFIG_SNAPSHOT.is_file()
    else load_config(ROOT / "config" / "project.yaml", PROFILE)
)
RUNTIME = LOADED_CONFIG.config.runtime
if RUNTIME.profile.value != PROFILE:
    raise ValueError("Workflow profile and canonical configuration snapshot disagree")
PYTHON_RUNNER = str(config.get("python_runner", "uv run --locked python"))
R_RUNNER = str(config.get("r_runner", "Rscript"))
SEED = int(RUNTIME.random_seed)
REQUIRE_R = bool(config.get("require_r", True))
STAGE_MODULES = dict(config.get("stage_modules", {}))

EXEC_ENV = " ".join(
    [
        "TZ=UTC",
        "LC_ALL=C.UTF-8",
        "OMP_NUM_THREADS=1",
        "OPENBLAS_NUM_THREADS=1",
        "MKL_NUM_THREADS=1",
        "VECLIB_MAXIMUM_THREADS=1",
        "NUMEXPR_NUM_THREADS=1",
        f"PYTHONPATH={shlex.quote(str(ROOT / 'src'))}",
        f"HFMD_R_RUNNER={shlex.quote(R_RUNNER)}",
    ]
)

PREFLIGHT_RECEIPT = str(RECEIPT_ROOT / "environment.json")
DATA_RECEIPT = str(RECEIPT_ROOT / "data.json")
PRIVACY_RECEIPT = str(RECEIPT_ROOT / "privacy.json")
ECOLOGICAL_RECEIPT = str(RECEIPT_ROOT / "ecological.json")
DYNAMICS_RECEIPT = str(RECEIPT_ROOT / "dynamics.json")
FIGURES_RECEIPT = str(RECEIPT_ROOT / "figures.json")
MANUSCRIPT_RECEIPT = str(RECEIPT_ROOT / "manuscript.json")
SUBMISSION_RECEIPT = str(RECEIPT_ROOT / "submission.json")
PUBLIC_EXPORT_RECEIPT = str(RECEIPT_ROOT / "public_export.json")

TARGET_OUTPUTS = {
    "environment": PREFLIGHT_RECEIPT,
    "data": DATA_RECEIPT,
    "privacy": PRIVACY_RECEIPT,
    "ecological": ECOLOGICAL_RECEIPT,
    "dynamics": DYNAMICS_RECEIPT,
    "figures": FIGURES_RECEIPT,
    "manuscript": MANUSCRIPT_RECEIPT,
    "submission": SUBMISSION_RECEIPT,
    "public_export": PUBLIC_EXPORT_RECEIPT,
}
ALL_SCIENTIFIC_TARGETS = (
    "environment",
    "data",
    "ecological",
    "dynamics",
    "figures",
    "manuscript",
    "submission",
)
requested = config.get("targets", ["data"])
if isinstance(requested, str):
    requested = [requested]
if "all" in requested:
    requested = list(ALL_SCIENTIFIC_TARGETS)
unknown = sorted(set(requested) - set(TARGET_OUTPUTS))
if unknown:
    raise ValueError(f"Unknown workflow target(s): {unknown}")
FINAL_TARGETS = [TARGET_OUTPUTS[name] for name in dict.fromkeys(requested)]
REQUIRE_PANDOC = bool(config.get("require_pandoc", PROFILE == "restricted")) and any(
    name in requested for name in ("manuscript", "submission")
)


localrules: all


rule all:
    input:
        FINAL_TARGETS


include: "rules/common.smk"
include: "rules/data.smk"
include: "rules/analysis.smk"
include: "rules/reporting.smk"
include: "rules/public.smk"
